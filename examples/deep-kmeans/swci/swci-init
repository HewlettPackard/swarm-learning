# Assumption : SWOP is already running

# SWCI context setup
EXIT ON FAILURE
wait for ip sn1
create context test-dkm with ip sn1
switch context test-dkm
EXIT ON FAILURE OFF

#Change to the directory where we are mounting the host
cd /platform/swarm/usr

# Create and finalize build task (idempotent — skip if already exists)
EXIT ON FAILURE OFF
create task from taskdefs/user_env_dkm_build_task.yaml
EXIT ON FAILURE
finalize task user_env_dkm_build_task
get task info user_env_dkm_build_task
get task body user_env_dkm_build_task
list tasks
EXIT ON FAILURE OFF

# Assign build task to taskrunner
EXIT ON FAILURE
RESET TASKRUNNER defaulttaskbb.taskdb.sml.hpe
ASSIGN TASK user_env_dkm_build_task TO defaulttaskbb.taskdb.sml.hpe WITH 1 PEERS
WAIT FOR TASKRUNNER defaulttaskbb.taskdb.sml.hpe
EXIT ON FAILURE OFF

# Delete swarm run task if it exists so updated env vars (MIN_PEERS etc.) take effect
EXIT ON FAILURE OFF
delete task swarm_dkm_task
EXIT ON FAILURE OFF

# Create and finalize swarm run task
EXIT ON FAILURE OFF
create task from taskdefs/swarm_dkm_task.yaml
EXIT ON FAILURE
finalize task swarm_dkm_task
get task info swarm_dkm_task
get task body swarm_dkm_task
list tasks
EXIT ON FAILURE OFF

# Reset contract before each training run to clear any stale state from
# previous failed runs (SWCI exits on error before the end-of-run reset)
EXIT ON FAILURE OFF
RESET CONTRACT defaultbb.cqdb.sml.hpe
EXIT ON FAILURE OFF

# Assign run task (2 peers: one per swarm node)
EXIT ON FAILURE
RESET TASKRUNNER defaulttaskbb.taskdb.sml.hpe
ASSIGN TASK swarm_dkm_task TO defaulttaskbb.taskdb.sml.hpe WITH 4 PEERS
SLEEP 30
PERFDATA defaultbb.cqdb.sml.hpe
SLEEP 30
PERFDATA defaultbb.cqdb.sml.hpe
SLEEP 30
PERFDATA defaultbb.cqdb.sml.hpe
SLEEP 30
PERFDATA defaultbb.cqdb.sml.hpe
SLEEP 30
PERFDATA defaultbb.cqdb.sml.hpe
SLEEP 30
PERFDATA defaultbb.cqdb.sml.hpe
WAIT FOR TASKRUNNER defaulttaskbb.taskdb.sml.hpe
# Grace period for ML container to save the model (TF model.save() needs ~60-90s)
SLEEP 120
RESET TASKRUNNER defaulttaskbb.taskdb.sml.hpe
EXIT ON FAILURE OFF

# List and reset training contract
EXIT ON FAILURE
LIST CONTRACTS
RESET CONTRACT defaultbb.cqdb.sml.hpe
EXIT ON FAILURE OFF

# Exit
EXIT
